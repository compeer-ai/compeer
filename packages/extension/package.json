{
  "name": "@barque/extension",
  "description": "Chrome Extension for Barque",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "bunx --bun wxt build",
    "build:firefox": "bunx --bun wxt build -b firefox",
    "zip": "bunx --bun wxt zip",
    "zip:firefox": "bunx --bun wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/svelte": "^5.0.6",
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/module-svelte": "^2.0.4",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.6"
  },
  "dependencies": {
    "@lucide/svelte": "^0.562.0",
    "classnames": "^2.5.1",
    "motion": "^12.23.26",
    "sv-router": "^0.14.0"
  }
}
