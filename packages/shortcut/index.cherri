#include 'actions/web'
#include 'actions/sharing'
#include 'actions/text'

function normalizeText(text input) {
    @collapsed = replaceText(
        '\\s+',
        ' ',
        @input,
        true,
        true
    )

    @trimmed = trimWhitespace(@collapsed)

    output(@trimmed)
}

function regex(text url) {
    @html = getWebpageContents(@url)

    @withoutScriptTags = replaceText(
        '<(script|style|noscript|iframe|canvas|svg)[^>]*>[\\s\\S]*?<\\/\\1>',
        ' ',
        @html,
        false,
        true
    )

    @withoutTags = replaceText(
        '<[^>]+>',
        ' ',
        @withoutScriptTags,
        false,
        true
    )

    @decoded = replaceText('&amp;', '&', @withoutTags)
    @decoded = replaceText('&lt;', '<', @decoded)
    @decoded = replaceText('&gt;', '>', @decoded)
    @decoded = replaceText('&quot;', '"', @decoded)
    @decoded = replaceText('&#39;', "'", @decoded)
    @decoded = replaceText('&nbsp;', ' ', @decoded)

    @normalized = normalizeText(@decoded)

    output(@normalized)
}

const clipboard = getClipboard()
@urls = getURLs(clipboard)
@COMPEER_URL = "http://localhost:3000"

if @urls.1 {
    @url = @urls.1
    @text = regex(@url)
    showWebpage(
        "{@COMPEER_URL}/wizard/capture?url={@url}&text={@text}"
    )
} else if count(clipboard) {
    showWebpage(
        "{@COMPEER_URL}/wizard/capture?text={clipboard}"
    )
}