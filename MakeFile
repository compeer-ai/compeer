.PHONY: build clean

build:
	docker build -f packages/web/Dockerfile -t compeer .
	export PATH="$(PWD)/packages/cli/build:$$PATH"

clean:
	docker rmi compeer || true

help:
	@echo "Available targets:"
	@echo "  build - Build the Docker image and add CLI executable to PATH"
	@echo "  clean - Remove the Docker image"
